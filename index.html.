<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Autoservice Mitte – Ihre Autowerkstatt</title>
<meta name="description" content="Autoservice Mitte – Autowerkstatt für Service, Diagnose und Reparaturen. Nehmen Sie Kontakt auf.">
<meta name="theme-color" content="#08090B">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap">
<style>
:root{--bg:#08090B;--surface:#101114;--line:rgba(255,255,255,.09);--text:#fff;--muted:#A1A1AA;--red:#E63946;--red-d:#c92f3b;
--head:"Barlow Condensed","Arial Narrow",Impact,sans-serif;--body:"Barlow",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
color-scheme:dark;box-sizing:border-box;padding-bottom:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{box-sizing:inherit;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:72px;background:var(--bg)}
body{font:400 1.0625rem/1.6 var(--body);color:var(--text);background:var(--bg);-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--red);outline-offset:3px;border-radius:4px}
.wrap{width:min(1160px,100% - 2.5rem);margin-inline:auto}
h1,h2,h3{font-family:var(--head);font-weight:700;line-height:1.02;letter-spacing:.005em}
h2{font-size:clamp(2.2rem,6vw,3.6rem)}
.lead{color:var(--muted);max-width:56ch}
section{padding:clamp(4rem,10vw,7.5rem) 0}
.icon{width:1.5rem;height:1.5rem;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;flex:none}

/* loader */
.curtain{position:fixed;inset:0;background:var(--bg);z-index:100;display:grid;place-items:center;animation:curtain .6s .5s ease forwards}
.curtain i{display:block;width:96px;height:3px;background:var(--red);transform-origin:left;animation:bar .5s ease forwards}
@keyframes bar{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@keyframes curtain{to{opacity:0;visibility:hidden}}

/* nav */
.nav{position:fixed;top:0;left:0;right:0;z-index:50;padding-top:env(safe-area-inset-top,0px);transition:background .3s,border-color .3s;border-bottom:1px solid transparent}
.nav.solid{background:rgba(8,9,11,.88);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-color:var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:68px}
.logo{font:700 1.45rem/1 var(--head);letter-spacing:.08em}
.logo b{color:var(--red);font-weight:700}
.links{display:none;gap:2rem;list-style:none;padding:0}
.links a{color:var(--muted);font-weight:500;font-size:.95rem;transition:color .2s}
.links a:hover,.links a.on{color:#fff}
.burger{width:48px;height:48px;border:0;background:none;color:#fff;display:grid;place-items:center;cursor:pointer;margin-right:-10px}
.burger span,.burger span::before,.burger span::after{display:block;width:22px;height:2px;background:currentColor;transition:transform .3s,background .3s;position:relative}
.burger span::before,.burger span::after{content:"";position:absolute;left:0}
.burger span::before{top:-7px}.burger span::after{top:7px}
.burger[aria-expanded=true] span{background:transparent}
.burger[aria-expanded=true] span::before{transform:translateY(7px) rotate(45deg)}
.burger[aria-expanded=true] span::after{transform:translateY(-7px) rotate(-45deg)}
.menu{position:fixed;inset:0;z-index:40;background:var(--bg);padding:calc(96px + env(safe-area-inset-top,0px)) 1.5rem 2rem;display:flex;flex-direction:column;justify-content:space-between;opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s}
.
